<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F8F8">

    <!-- ── Header bar ─────────────────────────────────────────────── -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:paddingHorizontal="16dp"
        android:paddingTop="40dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Nút back (Bên trái ngoài cùng) -->
        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            android:background="@drawable/bg_circle"
            android:backgroundTint="#F5F5F5"
            app:tint="#3C3C3C"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Khu vực hiển thị điểm số PvP (Giữa) -->
        <LinearLayout
            android:id="@+id/pvp_score_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginHorizontal="12dp"
            app:layout_constraintStart_toEndOf="@id/btn_back"
            app:layout_constraintEnd_toStartOf="@id/timer_container"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- Player 1 (Bên trái) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/iv_avatar_p1"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_marginEnd="6dp"
                        android:src="@drawable/ic_default_avatar"
                        android:scaleType="centerCrop" app:strokeColor="#1CB0F6"
                        app:strokeWidth="1.5dp" />

                    <TextView
                        android:id="@+id/tv_score_p1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="30đ"
                        android:textColor="#1CB0F6"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progress_score_p1"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:progressDrawable="@drawable/progress_bar_blue"
                    android:max="100"
                    android:progress="60" />
            </LinearLayout>

            <!-- Text VS trang nhã ở giữa ngăn cách -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="2dp"
                android:layout_marginTop="12dp"
                android:text="vs"
                android:textColor="#B8B8B8"
                android:textSize="11sp"
                android:textStyle="bold|italic" />

            <!-- Player 2 (Bên phải) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical|end"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:id="@+id/tv_score_p2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:text="40đ"
                        android:textColor="#D4537E"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/iv_avatar_p2"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_default_avatar"
                        android:scaleType="centerCrop"
                        app:strokeColor="#D4537E"
                        app:strokeWidth="1.5dp" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progress_score_p2"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:progressDrawable="@drawable/progress_bar_orange"
                    android:max="100"
                    android:progress="80"
                    android:rotationY="180" />
            </LinearLayout>
        </LinearLayout>

        <!-- Timer (Bên phải ngoài cùng) -->
        <LinearLayout
            android:id="@+id/timer_container"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:background="@drawable/bg_rounded_input"
            android:backgroundTint="#3C3C3C"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏱ "
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Hidden fields cho ViewModel -->
    <TextView
        android:id="@+id/tv_quiz_title"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_p1_user_id"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_p2_user_id"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- ── Scrollable body ────────────────────────────────────────── -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/header_bar"
        app:layout_constraintBottom_toTopOf="@id/footer_nav">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="24dp">

            <!-- Nhãn loại câu hỏi -->
            <TextView
                android:id="@+id/tv_question_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CHỌN ĐÁP ÁN ĐÚNG ĐỂ HOÀN THÀNH CÂU:"
                android:textColor="#A0A0A0"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:layout_marginBottom="14dp" />

            <!-- Card nội dung câu hỏi -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#EAEAEA"
                app:strokeWidth="1.5dp">

                <TextView
                    android:id="@+id/tv_question_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="24dp"
                    android:text="Nội dung câu hỏi"
                    android:textColor="#2C2C2C"
                    android:textSize="19sp"
                    android:lineSpacingExtra="6sp"
                    android:gravity="center"
                    android:textStyle="bold" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Container đáp án (dynamic) -->
            <LinearLayout
                android:id="@+id/container_answers"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ── Footer navigation ──────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/footer_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="6dp"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/btn_prev"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_chip_gray"
            android:text="QUAY LẠI"
            android:textAllCaps="true"
            android:textColor="#4B4B4B"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            app:backgroundTint="@null" />

        <Button
            android:id="@+id/btn_next"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1.3"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_button_orange_grad"
            android:text="XÁC NHẬN"
            android:textAllCaps="true"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            app:backgroundTint="@null" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>